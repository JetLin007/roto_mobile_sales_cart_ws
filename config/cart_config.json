{
  "_comment": "基线：架构 v1.2 + 协议 v1.3。硬件相关值为占位（Q2 待硬件端口-设备映射表）",
  "config_version": "0.2.0-v1.2-baseline",
  "cart": {
    "cart_id": "cart-0000001",
    "model": "RK3576S-NK6A21",
    "timezone_id": "Asia/Shanghai",
    "timezone_offset": "+08:00"
  },
  "protocol": {
    "version": "1.3",
    "mqtt_version": "5.0",
    "max_payload_bytes": 262144,
    "retain": false
  },
  "mqtt": {
    "cloud": {
      "host": "cloud-broker.example.com",
      "port": 8883,
      "tls": true,
      "ca_cert": "/opt/roto_ws/config/certs/ca.crt",
      "client_cert": "/opt/roto_ws/config/certs/client.crt",
      "client_key": "/opt/roto_ws/config/certs/client.key",
      "keepalive_sec": 60,
      "reconnect_backoff_sec": [1, 2, 4, 8, 16, 30],
      "topic_prefix": "cart/{cart_id}/",
      "query_guard": {
        "_comment": "协议 v1.3 §4.3：等 ACK 3s，最多重试 3 次仍无反馈发 cmd/query",
        "ack_timeout_ms": 3000,
        "max_retry": 3,
        "query_fallback": true
      }
    },
    "local": {
      "host": "127.0.0.1",
      "port": 1883,
      "tls": false,
      "topic_root": "local/",
      "cart_status_qos": 1,
      "heartbeat_qos": 0,
      "ui_heartbeat_period_sec": 2,
      "ui_heartbeat_timeout_sec": 6
    }
  },
  "time": {
    "_comment": "架构 v1.2 P10：四时间戳与云端对时为主时源；GNSS 有则作独立校验源，chrony 统一收敛",
    "sync_mode": "cloud_four_timestamp",
    "server_time_utc_field": "cmd/time_sync_resp.server_time_utc",
    "periodic_sync_interval_h": 6,
    "sync_on_reconnect": true,
    "max_acceptable_offset_ms": 50,
    "gnss": {
      "enabled": false,
      "required": false,
      "pps_gpio": null
    }
  },
  "chassis": {
    "device": "/dev/ttyS4",
    "baudrate": 115200,
    "control_period_ms": 20,
    "mcu_timeout_ms": 60,
    "frame": {
      "head": "0xAA55",
      "crc": "CRC16-MODBUS",
      "control_frame_bytes": [16, 32],
      "max_frame_bytes": 32
    },
    "ymodem": {
      "baudrates_allowed": [115200, 230400, 460800],
      "baudrate": 230400,
      "packet_bytes": 1024,
      "retry_timeout_ms": 300,
      "max_retry": 3,
      "progress_report_frames": 10
    }
  },
  "remote": {
    "_comment": "架构 v1.2 §6.9：ENTER_REMOTE 互锁 + 帧级 expire_at 极短窗口 + 500ms 无有效帧本地刹停",
    "motion_rate_hz": 10,
    "frame_expire_window_ms": 200,
    "stop_timeout_ms": 500,
    "session_default_ttl_ms": 1800000,
    "forbid_when": ["MAKING", "ORDERING", "OTA", "FAULT", "CHARGING"],
    "require_auth_ref": true
  },
  "peripherals": [
    {"module_id": "COFFEE-01", "target": "COFFEE_MACHINE",        "alias": "/dev/cart_485_coffee", "slave_id": 1, "poll_hz": 1, "command_timeout_ms": 30000},
    {"module_id": "ICE-01",    "target": "ICE_CREAM_CABINET",     "alias": "/dev/cart_485_ice",    "slave_id": 1, "poll_hz": 1, "command_timeout_ms": 20000},
    {"module_id": "MERCH-01",  "target": "MERCHANDISE_CABINET",   "alias": "/dev/cart_485_fridge", "slave_id": 1, "poll_hz": 1, "command_timeout_ms": 5000},
    {"module_id": "FRIDGE-01", "target": "DRINK_FRIDGE",          "alias": "/dev/cart_485_drink",  "slave_id": 1, "poll_hz": 1, "command_timeout_ms": 5000},
    {"module_id": "BMS-01",    "target": "BMS",                   "alias": "/dev/cart_485_bms",    "slave_id": 2, "poll_hz": 1, "command_timeout_ms": 3000}
  ],
  "cameras": [
    {"module_id": "CAM-FRONT", "alias": "/dev/cart_cam_front", "width": 1280, "height": 720, "fps": 15},
    {"module_id": "CAM-REAR",  "alias": "/dev/cart_cam_rear",  "width": 1280, "height": 720, "fps": 15}
  ],
  "state": {
    "heartbeat_period_sec": 30,
    "degraded_heartbeat_period_sec": 60,
    "node_heartbeat_timeout_sec": 3,
    "lwt_payload": {
      "_comment": "协议 v1.3 §4.5 只允许小 JSON，禁止裸字符串",
      "system_state": "OFFLINE",
      "retain": false
    }
  },
  "paths": {
    "config_dir": "/opt/roto_ws/config",
    "log_dir": "/opt/roto_ws/log",
    "data_dir": "/opt/roto_ws/data",
    "db": "/opt/roto_ws/data/cart.db",
    "ota_socket": "/run/cart-ota/agent.sock"
  },
  "budget": {
    "container_cpu_percent_max": 70,
    "container_mem_mb_max": 1536,
    "disk_gb_max": 8,
    "monthly_traffic_gb_max": 5,
    "image_size_mb_max": 800
  },
  "hardware_mapping_status": "PLACEHOLDER_Q2"
}
